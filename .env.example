# hamifs-convert 环境变量示例：复制为 .env 后按需修改

# 服务
HOST=0.0.0.0
PORT=8100

# 限制
TASK_TIMEOUT_SECONDS=120
MAX_UPLOAD_MB=100

# 存储：local 或 s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data

# MinIO / 云 OSS（STORAGE_BACKEND=s3 时生效）
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=hamifs-convert
PRESIGN_EXPIRES_SECONDS=3600

# Celery（留空则使用进程内后台线程，开发期够用）
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ── AI / RAG（演示期用云端 key；自建换 Ollama 时改三个变量即可）──
# LLM：DeepSeek（https://platform.deepseek.com 申请 key）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# Embedding：⚠️ DeepSeek 无向量化接口，用硅基流动（https://siliconflow.cn 申请 key）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
# 向量库（本地持久化，docker 部署时挂卷到 /app/chroma）
CHROMA_DIR=./data/chroma
# 切块与检索参数
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=5
